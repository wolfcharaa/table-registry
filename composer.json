{
    "name": "romanfedorskij/table-registry",
    "description": "PHP-first table registry core for explicit column contracts, PostgreSQL query compilation, row projection and XLSX export.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "table-registry",
        "registry",
        "postgresql",
        "xlsx",
        "query-builder"
    ],
    "authors": [
        {
            "name": "Roman Fedorskij"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "openspout/openspout": "^4.28",
        "psr/container": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Wolfcharaa\\TableRegistry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wolfcharaa\\TableRegistry\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:unit": "@test"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
