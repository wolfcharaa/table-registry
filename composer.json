{
    "name": "romanfedorskij/table-registry",
    "description": "PHP-first table registry core for explicit column contracts, PostgreSQL query compilation, row projection and XLSX export.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "table-registry",
        "registry",
        "postgresql",
        "xlsx",
        "query-builder"
    ],
    "authors": [
        {
            "name": "Roman Fedorskij"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "openspout/openspout": "^4.28 || ^5.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.16",
        "testo/testo": "0.10.54"
    },
    "suggest": {
        "llm/skills": "Synchronizes the bundled TableRegistry AI-agent skills into the consumer project."
    },
    "autoload": {
        "psr-4": {
            "Wolfcharaa\\TableRegistry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wolfcharaa\\TableRegistry\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/testo",
        "test:unit": "vendor/bin/testo --suite=Unit",
        "test:contract": "vendor/bin/testo --suite=Contract",
        "test:characterization": "vendor/bin/testo --suite=Characterization",
        "analyse": "@php -d memory_limit=512M vendor/bin/phpstan analyse --configuration=phpstan.neon.dist --no-progress --debug",
        "examples": "@php tools/run-examples.php",
        "check": [
            "@composer validate --strict",
            "@test",
            "@analyse",
            "@examples"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "extra": {
        "skills": {
            "source": "skills"
        }
    }
}
